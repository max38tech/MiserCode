# Backend server port
PORT=3001

# Directory the pipeline's child processes (claude / opencode) run in.
# This should be the target repo you want the autonomous pipeline to build in.
# Relative paths resolve against the repo root, regardless of which
# workspace directory the server process is actually launched from.
PIPELINE_WORK_DIR=./work

# Forwarded to the "generate" phase (opencode run) if set. Only needed if
# opencode isn't already authenticated on this machine — check first with
# `opencode auth list`. If a Google/Gemini credential is already listed
# there (from `opencode auth login`), you can leave this blank.
GEMINI_API_KEY=

# Rolling rate-limit window estimate used for the UI's health indicator.
# These are client-side estimates only; Anthropic does not expose exact
# remaining-quota figures via the CLI.
CLAUDE_WINDOW_MINUTES=300
CLAUDE_MAX_TURNS_PER_WINDOW=45
